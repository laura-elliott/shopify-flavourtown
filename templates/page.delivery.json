      "blocks": {
        "text_qEm7TD": {
          "type": "text",
          "settings": {
            "text": "<h2>Collect your order from us</h2><p>If you don’t live in our delivery areas or fancy picking up your precious baked goods instead, you can collect your order from our Fulham store or our main bakery kitchen in Park Royal. </p><p>All orders will be completed and boxed up, ready to collect from 10 am! We’ll show you your order and ask you to sign a collection note before you leave the store. Please have your order confirmation printed or handy on your phone, as we may need to check your order number. </p><p>PLEASE KEEP YOUR ORDER FLAT AND LEVEL AND HANDLE IT LIKE A NEWBORN BABY! CAKES AND CUPCAKES ARE SUPER-DELICATE.</p>",
            "enlarge_text": false
          }
        }
      },
